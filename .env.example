# --- ChatGPT sub-agent ---
OPENAI_API_KEY=sk-your-key-here
# Cost-efficient default; change for heavier tasks (e.g. gpt-4o)
OPENAI_MODEL=gpt-4o-mini
# Optional: custom / Azure / gateway endpoint
# OPENAI_BASE_URL=
OPENAI_MAX_TOKENS=2048

# --- ADB ---
# Windows example. Leave empty to auto-discover on PATH / common locations.
# ADB_PATH=C:\platform-tools\adb.exe
# Default device serial when a tool call omits one (see `adb devices`)
# ADB_DEFAULT_SERIAL=
SUBAI_TIMEOUT=60
# SUBAI_SCREENSHOT_DIR=
