# --- Sub-agent backend ---
# auto = prefer Codex CLI if installed (ChatGPT subscription, NO API cost),
#        else fall back to the OpenAI API.  Options: auto | codex | api
SUBAI_GPT_BACKEND=auto
# Codex CLI executable (run `codex login` once to use your ChatGPT plan)
SUBAI_CODEX_CMD=codex
# `--skip-git-repo-check` lets codex run outside a git/trusted directory
SUBAI_CODEX_ARGS=exec --skip-git-repo-check
# Default per-call timeout (s); AI can override per call up to the ceiling
SUBAI_CODEX_TIMEOUT=300
SUBAI_CODEX_MAX_TIMEOUT=1800
# Default model for the Codex backend (fixed to gpt-5.6-luna; override here)
SUBAI_CODEX_MODEL=gpt-5.6-luna

# --- OpenAI API (only needed for the "api" backend; billed per token) ---
# OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional: custom / Azure / gateway endpoint
# OPENAI_BASE_URL=
OPENAI_MAX_TOKENS=2048

# --- ADB ---
# Windows example. Leave empty to auto-discover on PATH / common locations.
# ADB_PATH=C:\platform-tools\adb.exe
# Default device serial when a tool call omits one (see `adb devices`)
# ADB_DEFAULT_SERIAL=
SUBAI_TIMEOUT=60
# SUBAI_SCREENSHOT_DIR=

# --- Real-time log monitoring ---
# Lines retained per live logcat session (ring buffer)
SUBAI_LOG_BUFFER_LINES=5000
# Upper bound (seconds) for a single adb_logcat_watch call
SUBAI_LOG_WATCH_MAX_TIMEOUT=300

# --- Background jobs & repeated execution ---
SUBAI_BG_BUFFER_LINES=5000
SUBAI_BG_WAIT_MAX_TIMEOUT=600
SUBAI_REPEAT_MAX_TIMES=500
